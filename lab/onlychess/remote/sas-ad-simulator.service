[Unit]
Description=Single-service Attack-Defense tick and checker simulator
After=sas-onlychess-lab.service
Requires=sas-onlychess-lab.service

[Service]
Type=simple
EnvironmentFile=/opt/sas-ad-lab/arena.env
ExecStart=/usr/bin/python3 /opt/sas-ad-lab/ad_simulator.py
WorkingDirectory=/opt/sas-ad-lab
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
