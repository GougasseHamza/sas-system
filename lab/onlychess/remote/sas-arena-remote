#!/bin/sh
set -eu

LAB_ROOT=/opt/sas-ad-lab
BASE_IMAGE=localhost/sas-onlychess:2025
BUILD_ROOT="$LAB_ROOT/builds"
APPROVED_ROOT="$LAB_ROOT/approved"
action=${1:-}

valid_revision() {
    [ "$#" -eq 1 ] || return 1
    case "$1" in
        ''|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "${#1}" -le 80 ]
}

wait_for_service() {
    attempt=0
    until curl -fsS http://127.0.0.1:4000/ >/dev/null; do
        attempt=$((attempt + 1))
        [ "$attempt" -lt 60 ] || return 1
        sleep 1
    done
}

case "$action" in
    verify)
        [ "$#" -eq 2 ] && valid_revision "$2" || exit 2
        revision=$2
        candidate_root="$LAB_ROOT/candidates/$revision"
        [ -f "$candidate_root/source.tar.gz" ]
        build_root="$BUILD_ROOT/$revision"
        rm -rf "$build_root"
        install -d -m 0700 -o root -g root "$build_root"
        python3 - "$candidate_root/source.tar.gz" "$build_root" <<'PY'
import os
import shutil
import sys
import tarfile
from pathlib import Path, PurePosixPath

archive = Path(sys.argv[1])
destination = Path(sys.argv[2])
maximum_bytes = 64 * 1024 * 1024
with tarfile.open(archive, "r:gz") as bundle:
    members = bundle.getmembers()
    if len(members) > 2000:
        raise ValueError("candidate archive contains too many members")
    total = 0
    for member in members:
        path = PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise ValueError(f"unsafe candidate path: {member.name}")
        allowed = member.name in {"main", "Containerfile", "templates"} or (
            len(path.parts) > 1 and path.parts[0] == "templates"
        )
        if not allowed or not (member.isdir() or member.isfile()):
            raise ValueError(f"unsupported candidate member: {member.name}")
        total += member.size
        if total > maximum_bytes:
            raise ValueError("candidate archive is too large")
        if member.name == "Containerfile":
            continue
        target = destination.joinpath(*path.parts)
        if member.isdir():
            target.mkdir(parents=True, exist_ok=True)
            os.chmod(target, 0o755)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        source = bundle.extractfile(member)
        if source is None:
            raise ValueError(f"could not read candidate member: {member.name}")
        with source, target.open("wb") as output:
            shutil.copyfileobj(source, output)
        os.chmod(target, 0o755 if member.name == "main" else 0o644)
if not (destination / "main").is_file() or not (destination / "templates").is_dir():
    raise ValueError("candidate must contain main and templates")
PY
        install -m 0644 -o root -g root "$LAB_ROOT/Containerfile" \
            "$build_root/Containerfile"
        cd "$build_root"
        podman build -t "localhost/sas-onlychess-candidate:$revision" \
            -f Containerfile .
        podman rm -f sas-onlychess-canary >/dev/null 2>&1 || true
        trap 'podman rm -f sas-onlychess-canary >/dev/null 2>&1 || true' EXIT
        podman run -d --name sas-onlychess-canary --network sas-ad-lab \
            --memory 384m -p 127.0.0.1:4001:4000 \
            "localhost/sas-onlychess-candidate:$revision" >/dev/null
        attempt=0
        until curl -fsS http://127.0.0.1:4001/ >/dev/null; do
            attempt=$((attempt + 1))
            [ "$attempt" -lt 60 ] || exit 1
            sleep 1
        done
        ONLYCHESS_CHECKER_ROOT="$LAB_ROOT/checker" \
            python3 "$LAB_ROOT/checker_roundtrip.py" \
            --base-url http://127.0.0.1:4001 --wait-seconds 0.5
        set +e
        ONLYCHESS_CHECKER_ROOT="$LAB_ROOT/checker" \
            python3 "$LAB_ROOT/chat_auth_probe.py" \
            --base-url http://127.0.0.1:4001 --wait-seconds 0.5
        probe_status=$?
        set -e
        [ "$probe_status" -eq 10 ]
        install -d -m 0700 -o root -g root "$APPROVED_ROOT"
        printf '%s\n' "localhost/sas-onlychess-candidate:$revision" \
            > "$APPROVED_ROOT/$revision"
        ;;
    deploy)
        [ "$#" -eq 2 ] && valid_revision "$2" || exit 2
        revision=$2
        [ -f "$APPROVED_ROOT/$revision" ]
        podman image exists "localhost/sas-onlychess-candidate:$revision"
        current=$(cat "$LAB_ROOT/active-image" 2>/dev/null || printf %s "$BASE_IMAGE")
        printf '%s\n' "$current" > "$LAB_ROOT/rollback-image"
        printf '%s\n' "localhost/sas-onlychess-candidate:$revision" \
            > "$LAB_ROOT/active-image"
        podman rm -f sas-onlychess >/dev/null 2>&1 || true
        systemctl restart sas-onlychess-lab.service
        wait_for_service
        ;;
    rollback)
        [ "$#" -eq 1 ] || exit 2
        image=$(cat "$LAB_ROOT/rollback-image")
        printf '%s\n' "$image" > "$LAB_ROOT/active-image"
        podman rm -f sas-onlychess >/dev/null 2>&1 || true
        systemctl restart sas-onlychess-lab.service
        wait_for_service
        ;;
    reset)
        [ "$#" -eq 1 ] || exit 2
        systemctl stop sas-ad-simulator.service
        systemctl stop sas-onlychess-lab.service
        podman rm -f sas-onlychess-canary >/dev/null 2>&1 || true
        podman rm -f sas-onlychess >/dev/null 2>&1 || true
        podman rm -f sas-onlychess-db >/dev/null 2>&1 || true
        podman volume rm sas-onlychess-db >/dev/null 2>&1 || true
        printf '%s\n' "$BASE_IMAGE" > "$LAB_ROOT/active-image"
        rm -f "$LAB_ROOT/rollback-image" "$LAB_ROOT/data/state.json"
        systemctl start sas-onlychess-lab.service
        systemctl start sas-ad-simulator.service
        ;;
    status)
        [ "$#" -eq 1 ] || exit 2
        systemctl is-active sas-onlychess-lab.service sas-ad-simulator.service
        printf 'active-image='
        cat "$LAB_ROOT/active-image"
        ;;
    *)
        echo "usage: sas-arena-remote {verify REVISION|deploy REVISION|rollback|reset|status}" >&2
        exit 2
        ;;
esac
