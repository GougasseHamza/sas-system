{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["candidate", "completed", "blocked", "error"]
    },
    "summary": {"type": "string"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statement": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {"type": "string"},
                "location": {"type": "string"},
                "detail": {"type": "string"}
              },
              "required": ["kind", "location", "detail"]
            }
          },
          "next_test": {"type": "string"}
        },
        "required": ["statement", "confidence", "evidence", "next_test"]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_actions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "status",
    "summary",
    "confidence",
    "claims",
    "artifacts",
    "next_actions"
  ]
}
